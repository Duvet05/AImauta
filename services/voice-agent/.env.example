# Dedicated credentials for the AImauta LiveKit Cloud project.
LIVEKIT_URL=wss://aimauta-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The worker reaches the Next.js internal endpoint over PowerEdge loopback.
AIMAUTA_APP_URL=http://127.0.0.1:3309
AIMAUTA_AGENT_SECRET=

REQUEST_TIMEOUT_SECONDS=50
# Authoritative server-side cap for one voice job (1–15 minutes).
MAX_SESSION_SECONDS=600
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=es-419
TTS_MODEL=inworld/inworld-tts-2
TTS_VOICE=Diego
TTS_LANGUAGE=es

# Optional Tavus video avatar. Set only this exact switch to false to return
# immediately to ordinary LiveKit audio plus the local 3D avatar.
TAVUS_AVATAR_ENABLED=false
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
