# Dedicated AImauta credentials; do not reuse another product's project.
LIVEKIT_URL=wss://project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=

# The worker reaches the Next.js internal endpoint over PowerEdge loopback.
AIMAUTA_APP_URL=http://127.0.0.1:3000
AIMAUTA_AGENT_SECRET=

REQUEST_TIMEOUT_SECONDS=50
# Authoritative server-side cap for one voice job (1–15 minutes).
MAX_SESSION_SECONDS=600
STT_MODEL=nova-3
STT_LANGUAGE=es
TTS_MODEL=aura-2-selena-es
