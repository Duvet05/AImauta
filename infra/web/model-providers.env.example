# Runtime-only model credentials. Keep this file outside the repository with
# mode 600 and load it only into the web application container.
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDERS=
OPENAI_API_KEY=replace-with-a-dedicated-openai-project-key
OPENAI_MODEL=gpt-4.1
XAI_API_KEY=replace-with-a-dedicated-xai-team-key
XAI_MODEL=grok-4.3
GOOGLE_GENAI_API_KEY=replace-with-a-dedicated-google-project-key
GOOGLE_GENAI_MODEL=gemini-3.6-flash
