AIMAUTA_PUBLIC_URL=https://aprende.example.edu
DATABASE_URL=postgresql://aimauta:replace-me@127.0.0.1:5432/aimauta?schema=public
AIMAUTA_CONTENT_DIR=/srv/aimauta/content
AIMAUTA_INDEX_DIR=/srv/aimauta/indexes
AIMAUTA_MANIFEST_DIR=/srv/aimauta/manifests
AIMAUTA_EXERCISE_MANIFEST_DIR=/srv/aimauta/manifests/exercises
AIMAUTA_EXERCISE_SOLUTION_DIR=/srv/aimauta/exercise-solutions
AIMAUTA_REMOTE_CONTENT_PROXY=false
AIMAUTA_TRUST_PROXY_HEADERS=true
AIMAUTA_SESSION_SECRET=generate-a-random-secret-with-at-least-32-characters
AIMAUTA_AGENT_SECRET=generate-an-independent-secret-with-at-least-32-characters
AIMAUTA_ADMIN_SECRET=generate-an-independent-secret-with-at-least-32-characters
AIMAUTA_ASSIGNMENT_ADMIN_SECRET=generate-an-independent-admin-secret-with-at-least-32-characters
AIMAUTA_ASSIGNMENT_TOKEN_SECRET=generate-an-independent-token-secret-with-at-least-32-characters
AIMAUTA_LLM_TIMEOUT_MS=12000
AIMAUTA_LLM_MAX_CONCURRENCY=2
AIMAUTA_LLM_ATTEMPTS_PER_MINUTE=20
AIMAUTA_LLM_DAILY_REQUEST_LIMIT=300
AIMAUTA_LLM_DAILY_INPUT_TOKEN_LIMIT=150000
AIMAUTA_LLM_DAILY_OUTPUT_TOKEN_LIMIT=6000
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=gemma4:e4b-it-qat
OLLAMA_TIMEOUT_MS=45000
AIMAUTA_AVATAR_ENABLED=false
AIMAUTA_VOICE_TUTOR_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
