# Copy with init-env.sh. Never commit the generated file.
LIVEKIT_DOMAIN=livekit.example.edu
LIVEKIT_TURN_DOMAIN=turn.example.edu
LIVEKIT_NODE_IP=203.0.113.10

# init-env.sh writes the numeric owner of runtime files and independent random
# credentials. The same API pair is copied into Next.js and the voice worker's
# protected environment files.
LIVEKIT_RUNTIME_UID=1000
LIVEKIT_RUNTIME_GID=1000
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
