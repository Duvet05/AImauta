{
  "name": "aimauta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run catalog:validate",
    "build": "next build",
    "postbuild": "node scripts/audit-client-catalog.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "content:sync": "tsx scripts/sync-content.ts",
    "content:index": "tsx scripts/index-content.ts",
    "exercises:ingest": "tsx scripts/ingest-exercises.ts",
    "exercises:validate": "tsx scripts/validate-exercise-release.ts",
    "exercises:promote": "tsx scripts/promote-exercise-release.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@napi-rs/canvas": "1.0.2",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "livekit-client": "2.21.0",
    "livekit-server-sdk": "2.17.0",
    "next": "16.2.11",
    "pdfjs-dist": "6.1.200",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.180.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "^12.0.4",
    "pdf-parse": "2.4.5",
    "prisma": "^7.9.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
