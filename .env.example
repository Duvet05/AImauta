# School directory database (Prisma: level -> grade -> course -> student/teacher).
DATABASE_URL=

# Runtime storage. PDFs and extracted text must not be committed to Git.
AIMAUTA_CONTENT_DIR=/srv/aimauta/content
AIMAUTA_INDEX_DIR=/srv/aimauta/indexes
AIMAUTA_MANIFEST_DIR=/srv/aimauta/manifests

# Keep runtime delivery local after the verified sync job. Enable the remote
# proxy only for a controlled recovery path; its URLs remain allowlisted.
AIMAUTA_REMOTE_CONTENT_PROXY=false

# Signed anonymous learning state; use independent random values (32+ chars).
AIMAUTA_SESSION_SECRET=
AIMAUTA_AGENT_SECRET=

# Interim admin bearer for the school-directory CRUD API (students, teachers,
# courses, grades, levels). Independent random value (32+ chars). Requests to
# those routes must send `Authorization: Bearer <this>`. Missing/short = 503.
AIMAUTA_ADMIN_SECRET=

# Keep false unless a trusted reverse proxy removes client-supplied forwarding
# headers and writes canonical CF-Connecting-IP, X-Real-IP or X-Forwarded-For.
AIMAUTA_TRUST_PROXY_HEADERS=false

# Ollama stays private in Aule; this is the loopback-only SSH tunnel in PowerEdge.
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=gemma4:e4b-it-qat
OLLAMA_TIMEOUT_MS=45000

# Fail-closed visual preview. It also requires ?avatar=1 on a learning URL.
AIMAUTA_AVATAR_ENABLED=false

# Independent fail-closed switch for microphone and LiveKit token API.
# Only the exact value "true" enables the optional voice tutor.
AIMAUTA_VOICE_TUTOR_ENABLED=false

# Optional LiveKit Cloud voice layer. The browser receives LIVEKIT_URL while
# the server SDK uses the HTTPS URL of the same dedicated AImauta project.
LIVEKIT_URL=wss://aimauta-project.livekit.cloud
LIVEKIT_API_URL=https://aimauta-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public origin used to build absolute URLs for social previews (og:image).
# WhatsApp and other clients resolve the preview image against this origin, so
# it must be the real public URL in production. Defaults to https://aimauta.pe.
AIMAUTA_SITE_URL=https://aimauta.pe
