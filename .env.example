# Runtime storage. PDFs and extracted text must not be committed to Git.
AIMAUTA_CONTENT_DIR=/srv/aimauta/content
AIMAUTA_INDEX_DIR=/srv/aimauta/indexes

# Only allowlisted official URLs are accepted by the content proxy/sync job.
AIMAUTA_REMOTE_CONTENT_PROXY=true

# Ollama stays private; expose it only to this server over Tailscale/VPN.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b-it-qat
OLLAMA_TIMEOUT_MS=45000

# Optional future LiveKit voice layer.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
