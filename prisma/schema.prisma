// Prisma schema for the school directory (level -> grade -> course -> student/teacher).
// Unrelated to the book catalog taxonomy in lib/catalog.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Level {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades Grade[]
}

model Grade {
  id        String   @id @default(cuid())
  name      String
  levelId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  level   Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([levelId, name])
  @@index([levelId])
}

model Course {
  id        String   @id @default(cuid())
  name      String
  gradeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grade       Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  teachers    Teacher[]    @relation("TeacherCourses")
  enrollments Enrollment[]
  assignments Assignment[]

  @@unique([gradeId, name])
  @@index([gradeId])
}

model Student {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  completions AssignmentCompletion[]
}

model Teacher {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses       Course[]       @relation("TeacherCourses")
  progressNotes ProgressNote[]
  assignments   Assignment[]
}

// A student's participation in one course. Per-student grades and teacher
// feedback attach here rather than to Student or Course directly, since both
// are scoped to a specific student/course pairing.
model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  evaluations   Evaluation[]
  progressNotes ProgressNote[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

// A task a teacher hands out to a course, pointing at pages of a book in the
// versioned catalog (bookId/unitId are plain strings for the same reason as
// Evaluation.unitId: the catalog lives in /config, not in this database).
//
// `token` is the only thing that travels in the shared link and QR code. It
// carries no personal data, so a forwarded code never leaks who it was for,
// and it can be expired or revoked without touching academic records.
model Assignment {
  id           String    @id @default(cuid())
  token        String    @unique
  teacherId    String
  courseId     String
  bookId       String
  unitId       String?
  title        String
  instructions String?
  firstPage    Int
  lastPage     Int
  active       Boolean   @default(true)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  teacher     Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions AssignmentCompletion[]

  @@index([teacherId])
  @@index([courseId])
}

// Evidence that someone finished an assignment. Deliberately holds no PII: the
// student is identified by the alias or roll number the teacher already uses in
// class, and `studentId` stays null for anonymous QR access.
//
// `shareToken` addresses the celebration image. It is separate from
// Assignment.token so that sharing an achievement never exposes the task link,
// and so a single completion can be revoked on its own.
model AssignmentCompletion {
  id           String   @id @default(cuid())
  shareToken   String   @unique
  assignmentId String
  studentId    String?
  studentAlias String
  attemptCount Int      @default(0)
  hintsUsed    Int      @default(0)
  autonomy     Autonomy @default(GUIDED)
  completedAt  DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentAlias])
  @@index([assignmentId])
  @@index([studentId])
}

// How much support the student needed to finish. Derived from hints used and
// attempts made, never shown to the student as a score or a ranking: it exists
// so the teacher can see who to check on, not to label anyone.
enum Autonomy {
  INDEPENDENT
  GUIDED
  SUPPORTED
}

// One graded evaluation for a student in a course. unitId is a plain string,
// not a foreign key: units live in the versioned book-catalog config
// (lib/curriculum.ts / config/curricula.v3.json), not in this database.
model Evaluation {
  id           String   @id @default(cuid())
  enrollmentId String
  title        String?
  score        Float?
  maxScore     Float?
  unitId       String?
  evaluatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment    Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  progressNotes ProgressNote[]

  @@index([enrollmentId])
}

// Raw, verbatim copy of a versioned JSON file from /config (e.g. catalog.v3,
// curricula.v3), seeded for querying/auditing from the database. This is not a
// relational model of the catalog: the app still reads /config directly via
// lib/catalog.ts and lib/curriculum.ts, matching the Evaluation.unitId note above.
model ConfigSnapshot {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  seededAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProgressStatus {
  EXCELLING
  ON_TRACK
  NEEDS_SUPPORT
  AT_RISK
}

// A teacher's qualitative feedback and status indicator for a student's
// progress in a course. Append-only: the "current" status for an enrollment
// is simply its most recent ProgressNote, keeping history intact rather than
// overwriting a single mutable field.
model ProgressNote {
  id           String         @id @default(cuid())
  enrollmentId String
  teacherId    String
  evaluationId String?
  feedback     String
  status       ProgressStatus
  createdAt    DateTime       @default(now())

  enrollment Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher    Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  evaluation Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  @@index([enrollmentId])
  @@index([teacherId])
}
