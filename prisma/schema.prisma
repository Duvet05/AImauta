// Prisma persistence for the school directory and anonymous QR assignments.
// Book metadata remains versioned in lib/catalog.ts rather than relational.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Level {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades Grade[]
}

model Grade {
  id        String   @id @default(cuid())
  name      String
  levelId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  level   Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([levelId, name])
  @@index([levelId])
}

model Course {
  id        String   @id @default(cuid())
  name      String
  gradeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grade       Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  teachers    Teacher[]    @relation("TeacherCourses")
  enrollments Enrollment[]
  assignments Assignment[]

  @@unique([gradeId, name])
  @@index([gradeId])
}

model Student {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
}

model Teacher {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses       Course[]       @relation("TeacherCourses")
  progressNotes ProgressNote[]
  assignments   Assignment[]
}

// A student's participation in one course. Per-student grades and teacher
// feedback attach here rather than to Student or Course directly, since both
// are scoped to a specific student/course pairing.
model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  evaluations   Evaluation[]
  progressNotes ProgressNote[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

// One graded evaluation for a student in a course. unitId is a plain string,
// not a foreign key: units live in the versioned book-catalog config
// (lib/curriculum.ts / config/curricula.v3.json), not in this database.
model Evaluation {
  id           String   @id @default(cuid())
  enrollmentId String
  title        String?
  score        Float?
  maxScore     Float?
  unitId       String?
  evaluatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment    Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  progressNotes ProgressNote[]

  @@index([enrollmentId])
}

// Raw, verbatim copy of a versioned JSON file from /config (e.g. catalog.v3,
// curricula.v3), seeded for querying/auditing from the database. This is not a
// relational model of the catalog: the app still reads /config directly via
// lib/catalog.ts and lib/curriculum.ts, matching the Evaluation.unitId note above.
model ConfigSnapshot {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  seededAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProgressStatus {
  EXCELLING
  ON_TRACK
  NEEDS_SUPPORT
  AT_RISK
}

// A teacher's qualitative feedback and status indicator for a student's
// progress in a course. Append-only: the "current" status for an enrollment
// is simply its most recent ProgressNote, keeping history intact rather than
// overwriting a single mutable field.
model ProgressNote {
  id           String         @id @default(cuid())
  enrollmentId String
  teacherId    String
  evaluationId String?
  feedback     String
  status       ProgressStatus
  createdAt    DateTime       @default(now())

  enrollment Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher    Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  evaluation Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  @@index([enrollmentId])
  @@index([teacherId])
}

enum AssignmentKind {
  TASK
  WORKSHEET
  PAGE
  EXERCISE
  REINFORCEMENT
}

enum AssignmentStatus {
  ACTIVE
  REVOKED
  ARCHIVED
}

enum AssignmentItemKind {
  UNIT
  PAGE
  EXERCISE
}

enum AssignmentRunStatus {
  IN_PROGRESS
  COMPLETED
}

enum AssignmentItemProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// A teacher-authored activity shared through an opaque QR/link token. The raw
// token is never stored in plaintext: publicTokenHash resolves public access,
// while publicTokenCiphertext is only decrypted by authenticated staff routes
// when the QR needs to be downloaded again.
model Assignment {
  id                    String           @id @default(cuid())
  publicTokenHash       String           @unique
  publicTokenCiphertext String
  kind                  AssignmentKind
  status                AssignmentStatus @default(ACTIVE)
  title                 String
  instructions          String?
  teacherId             String
  courseId              String?
  groupLabel            String?
  availableFrom         DateTime?
  expiresAt             DateTime
  maxHintLevel          Int              @default(3)
  requiredItemCount     Int
  minimumTurnsPerItem   Int              @default(1)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  teacher Teacher          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  course  Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  items   AssignmentItem[]
  runs    AssignmentRun[]

  @@index([teacherId, createdAt])
  @@index([courseId])
  @@index([status, expiresAt])
}

// Immutable snapshot of one launch target. Content identifiers are accompanied
// by the PDF checksum, curriculum version and exercise revision so stale QRs
// fail closed after a reviewed content release changes.
model AssignmentItem {
  id                String             @id @default(cuid())
  assignmentId      String
  position          Int
  kind              AssignmentItemKind
  bookId            String
  bookSha256        String
  curriculumVersion String
  unitId            String?
  pages             Int[]
  exerciseId        String?
  exerciseRevision  Int?
  label             String
  title             String
  createdAt         DateTime           @default(now())

  assignment Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  progress   AssignmentItemProgress[]

  @@unique([assignmentId, position])
  @@unique([assignmentId, id])
  @@index([bookId])
}

// An anonymous learner run. Possession of the separate resume token authorizes
// access to this run; no name, email, conversation or attempt text is stored.
model AssignmentRun {
  id                     String              @id @default(cuid())
  assignmentId           String
  resumeTokenHash        String              @unique
  status                 AssignmentRunStatus @default(IN_PROGRESS)
  receiptTokenHash       String?             @unique
  receiptTokenCiphertext String?
  startedAt              DateTime            @default(now())
  lastActivityAt         DateTime            @default(now())
  completedAt            DateTime?

  assignment Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  progress   AssignmentItemProgress[]

  @@unique([assignmentId, id])
  @@index([assignmentId, startedAt])
  @@index([status, lastActivityAt])
}

model AssignmentItemProgress {
  id               String                       @id @default(cuid())
  assignmentId     String
  runId            String
  assignmentItemId String
  status           AssignmentItemProgressStatus @default(NOT_STARTED)
  turnCount        Int                          @default(0)
  attemptCount     Int                          @default(0)
  hintLevel        Int                          @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  updatedAt        DateTime                     @updatedAt

  run  AssignmentRun  @relation(fields: [assignmentId, runId], references: [assignmentId, id], onDelete: Cascade)
  item AssignmentItem @relation(fields: [assignmentId, assignmentItemId], references: [assignmentId, id], onDelete: Cascade)

  @@unique([runId, assignmentItemId])
  @@index([assignmentId, assignmentItemId])
}
