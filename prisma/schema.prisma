// Prisma schema for the school directory (level -> grade -> course -> student/teacher).
// Unrelated to the book catalog taxonomy in lib/catalog.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Level {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades Grade[]
}

model Grade {
  id        String   @id @default(cuid())
  name      String
  levelId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  level   Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([levelId, name])
  @@index([levelId])
}

model Course {
  id        String   @id @default(cuid())
  name      String
  gradeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grade       Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  teachers    Teacher[]    @relation("TeacherCourses")
  enrollments Enrollment[]

  @@unique([gradeId, name])
  @@index([gradeId])
}

model Student {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
}

model Teacher {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses       Course[]       @relation("TeacherCourses")
  progressNotes ProgressNote[]
}

// A student's participation in one course. Per-student grades and teacher
// feedback attach here rather than to Student or Course directly, since both
// are scoped to a specific student/course pairing.
model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  evaluations   Evaluation[]
  progressNotes ProgressNote[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

// One graded evaluation for a student in a course. unitId is a plain string,
// not a foreign key: units live in the versioned book-catalog config
// (lib/curriculum.ts / config/curricula.v3.json), not in this database.
model Evaluation {
  id           String    @id @default(cuid())
  enrollmentId String
  title        String?
  score        Float?
  maxScore     Float?
  unitId       String?
  evaluatedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollment    Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  progressNotes ProgressNote[]

  @@index([enrollmentId])
}

enum ProgressStatus {
  EXCELLING
  ON_TRACK
  NEEDS_SUPPORT
  AT_RISK
}

// A teacher's qualitative feedback and status indicator for a student's
// progress in a course. Append-only: the "current" status for an enrollment
// is simply its most recent ProgressNote, keeping history intact rather than
// overwriting a single mutable field.
model ProgressNote {
  id           String         @id @default(cuid())
  enrollmentId String
  teacherId    String
  evaluationId String?
  feedback     String
  status       ProgressStatus
  createdAt    DateTime       @default(now())

  enrollment Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher    Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  evaluation Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  @@index([enrollmentId])
  @@index([teacherId])
}
